<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="Head">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">18sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">#FF36D8FF</item>
    <item name="android:letterSpacing">0.08</item>
    <item name="android:paddingTop">24dp</item>
    <item name="android:paddingBottom">8dp</item>
  </style>
  <style name="Lbl">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">14sp</item>
    <item name="android:textColor">#FF90A5B6</item>
    <item name="android:paddingTop">8dp</item>
  </style>
  <style name="Note">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">13sp</item>
    <item name="android:textColor">#FF7F9DB1</item>
    <item name="android:paddingTop">6dp</item>
    <item name="android:paddingBottom">6dp</item>
  </style>
  <style name="Inp">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textColor">#FFF2F8FF</item>
    <item name="android:textColorHint">#FF5F7686</item>
  </style>
  <style name="Sw">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">16sp</item>
    <item name="android:paddingTop">14dp</item>
    <item name="android:paddingBottom">6dp</item>
  </style>
  <style name="Btn">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginTop">10dp</item>
  </style>
</resources>
